# ============================================================================
# doc-harness - Environment variables (raíz; la usa docker compose + el api)
# Copiá este archivo a .env y completá los valores reales. Nunca commitees .env.
#
# Secciones al estilo atiende. El api acepta REDIS_URL directo O lo deriva de
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD (mismo patrón que atiende → reutiliza la
# misma Redis compartida del server).
#
# ⚠️ OBLIGATORIO antes de levantar (si falta, el contenedor NO arranca, a propósito):
#   · JWT_SECRET      → el MISMO valor de atiende EN EL SERVER. Si no, la pestaña
#                       Documentos da 401 y parece que el harness está roto.
#   · DATABASE_HOST / POSTGRES_USER / POSTGRES_PASSWORD → los de atiende en el server.
#   · DEEPSEEK_API_KEY + DEEPSEEK_MODEL → para IA real (vacío = modo mock determinístico).
# ============================================================================

# ── 1. APLICACIÓN ────────────────────────────────────────────────────────────
NODE_ENV=development
# Puerto del api dentro del contenedor y publicado en el host.
# atiende usa 3013, cv-harness 3100 y social-harness 3200: acá 3300 para no chocar.
API_PORT=3300
# El frontend NO se levanta acá: es la pestaña "Documentos" del dashboard de
# atiende (proyecto dashboard/, puerto 3001 del host). No hay WEB_PORT.
# Orígenes permitidos por CORS (CSV). '*' en dev; en el server poné el dominio
# del dashboard. La API usa Bearer (no cookies).
CORS_ALLOWED_ORIGINS=*

# ── 2. POSTGRES / REDIS (EXTERNOS en el server — NO se crean en compose) ─────
# Postgres = el mismo de atiende (atiende-postgres, imagen pgvector) con una
# base "docharnes" propia; se crea SOLA al boot (prisma/ensure-database.ts).
# Para dev local usá:
#   DATABASE_HOST=docharnes-postgres · POSTGRES_USER=docharnes · PASSWORD=docharnes
DATABASE_HOST=atiende-postgres
DATABASE_PORT=5432
POSTGRES_USER=atiende
POSTGRES_PASSWORD=atiende_dev
POSTGRES_DB=docharnes
# OPCIONAL: si preferís pasar la URL completa, esta gana sobre las 4 anteriores.
# DATABASE_URL=postgresql://atiende:atiende_dev@atiende-postgres:5432/docharnes?schema=public
# Redis COMPARTIDA (hostname "redis" en microservices-network), la MISMA que ya
# usan atiende, cv-harness y social-harness.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefijo de las colas BullMQ para no pisarse con los otros harness. Comparten la
# MISMA Redis, así que el prefijo es lo único que separa sus llaves.
QUEUE_PREFIX=docharnes

# ── Puertos LOCALES (solo docker-compose.infra.yml) ──────────────────────────
# Postgres publicado en el host (atiende 5433 · cv-harness 5434 · social 5435 → acá 5436).
# La Redis NO se levanta en local: se reutiliza el contenedor compartido `redis`.
POSTGRES_PORT=5436

# ── 3. IA (patrón adaptador: un puerto + un adaptador por proveedor) ─────────
# DeepSeek es el proveedor principal: el MISMO que ya usan atiende y los otros
# harness (comparten la llave, así que se copia tal cual de cualquiera).
#   grep '^DEEPSEEK_API_KEY=' ../cv-harness/.env
DEEPSEEK_API_KEY=
# OJO: el modelo debe ser el MISMO que usan los otros harnesses EN EL SERVER.
# Hoy es deepseek-v4-flash (no el deepseek-chat de los .env.example viejos).
DEEPSEEK_MODEL=deepseek-v4-flash
# Opcional: pasar por un proxy/gateway compatible. Vacío = https://api.deepseek.com
DEEPSEEK_BASE_URL=

# Proveedor principal: auto | deepseek | groq | mock
#   auto = deepseek > groq > mock (sin llaves queda en mock y el flujo corre E2E).
LLM_PROVIDER=auto
# Respaldo cuando el principal falla: auto | deepseek | groq | none
LLM_FALLBACK=auto
# Groq como respaldo (la llave ya existe en el .env de atiende).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=

# Límites de la capa de IA (mismos valores que usa atiende).
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
# Precio del modelo por 1M de tokens, SOLO para el medidor de gasto (GET /usage).
# Vacío = se usa la tabla de apps/api/src/modules/llm/pricing.ts.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# ── 4. ALMACENAMIENTO DE ARCHIVOS ────────────────────────────────────────────
# local = disco (volumen docker `docharnes_data` → DOCS_STORAGE_DIR). Preparado
# para sumar otro driver (S3) sin tocar el resto: ver modules/storage.
STORAGE_DRIVER=local
DOCS_STORAGE_DIR=/data
# Tamaño máximo de un archivo subido (MB). Se valida en la frontera.
MAX_UPLOAD_MB=25

# ── 5. AUTH (dashboard) ──────────────────────────────────────────────────────
# OBLIGATORIO. MISMO valor que tiene atiende EN EL SERVER: no hay login propio,
# la pestaña reutiliza la sesión de atiende (una sola sesión, sin segundo login).
# Obtenelo y copialo tal cual:
#   docker exec <contenedor-atiende> printenv JWT_SECRET
# Vacío (como acá) o el valor de ejemplo `dev-secret-change-me` → el api FALLA al
# arrancar y lo dice. Es a propósito: arrancar con un secreto distinto da 401 en
# silencio, que es mucho peor de diagnosticar.
# Solo si el harness se usara SOLO (sin atiende): openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── 6. PLANTILLA DE EJEMPLO (opt-in) ─────────────────────────────────────────
# Siembra un par de plantillas de demostración. El seed corre en CADA boot, así
# que con esto en true las plantillas de demo vuelven a aparecer si las borrás.
# En el server dejalo en false: las plantillas las creás vos desde el dashboard.
SEED_DEMO=false

# ── 7. OBSERVABILIDAD ────────────────────────────────────────────────────────
LOG_LEVEL=info
TRUST_PROXY=0

# ── CHECKLIST SERVER (copiá este archivo a .env en el server) ────────────────
# 1. La base "docharnes" se crea SOLA al boot (prisma/ensure-database.ts) antes
#    de `migrate deploy` y el seed. No hay que aprovisionar nada a mano.
# 2. JWT_SECRET → el MISMO valor que tiene atiende EN EL SERVER (login sin 2do
#    paso). Obtenelo y copialo tal cual:
#      docker exec <contenedor-atiende> printenv JWT_SECRET
#    Si no coincide, la pestaña Documentos da 401 «Doc Harness rechazó la sesión».
# 3. DEEPSEEK_API_KEY → la MISMA llave que ya usan atiende/cv-harness, y
#    DEEPSEEK_MODEL debe coincidir (hoy deepseek-v4-flash).
# 4. API_PORT=3300 y CORS_ALLOWED_ORIGINS con el dominio del dashboard.
# 5. Verificá la capa de IA antes de confiar en el flujo:
#      docker compose exec api npm run llm:check
# Nota: Postgres = "atiende-postgres" y Redis = "redis" en microservices-network.
# ⚠️ NO uses el .env de tu máquina local (apunta a docharnes-postgres).
