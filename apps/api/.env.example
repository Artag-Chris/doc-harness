# ============================================================================
# doc-harness API — env de DESARROLLO LOCAL (fuera de docker).
# Copiá este archivo a apps/api/.env. Dentro de docker NO se usa: el compose le
# pasa el entorno del .env de la raíz.
#
# Para levantar la infra local:
#   docker compose -f docker-compose.infra.yml up -d
# ============================================================================

NODE_ENV=development
PORT=3300
CORS_ALLOWED_ORIGINS=*

# ── Postgres/Redis LOCALES (corriendo fuera de docker) ──────────────────────
# OJO: en el server estos hosts son "atiende-postgres" y "redis".
DATABASE_URL=postgresql://docharnes:docharnes@localhost:5436/docharnes?schema=public
# Redis COMPARTIDA, publicada por cv-harness en el puerto host 6380.
# Equivale a `redis:6379` dentro de la red microservices-network.
REDIS_URL=redis://localhost:6380
QUEUE_PREFIX=docharnes

# ── IA (vacías = mock determinístico: el flujo corre E2E sin red) ───────────
# Misma llave y mismo modelo que atiende/cv-harness.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=
LLM_PROVIDER=auto
LLM_FALLBACK=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# ── Almacenamiento de archivos ──────────────────────────────────────────────
STORAGE_DRIVER=local
DOCS_STORAGE_DIR=./.data
MAX_UPLOAD_MB=25

# ── Auth ────────────────────────────────────────────────────────────────────
# En el server tiene que ser EXACTAMENTE el mismo `JWT_SECRET` que usa atiende: el
# harness no firma tokens, solo VERIFICA los que emite atiende.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d

# ── Plantilla de ejemplo (opt-in) ───────────────────────────────────────────
SEED_DEMO=false

# ── Observabilidad ──────────────────────────────────────────────────────────
LOG_LEVEL=info
TRUST_PROXY=0
